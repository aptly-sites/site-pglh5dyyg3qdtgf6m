---
// Static, crawlable listings grid — generated at build time from the company's
// public Aptly listings feed. Replaces the old iframe-embedded search widget so
// search engines can see and index real rental content and links, not just an
// empty <iframe> shell.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { site } from '../../config';
import { fetchListings, street, cityStateZip, photos, money } from '../../lib/listings';

const listings = await fetchListings(site.companyId);

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: listings.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/rentals/${p._id}/`, Astro.site || Astro.url).toString(),
  })),
};
---

<BaseLayout
  title={`Available Rentals | ${site.companyName}`}
  description={`Browse current rental homes managed by ${site.companyName}.`}
>
  <Nav homepage={false} activeHref="/rentals" />

  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />

  <section style="padding:128px 24px 32px;text-align:center;">
    <div class="container" style="max-width:760px;">
      <div class="section-label">Rental Search</div>
      <h1 class="section-title">Available Rentals</h1>
      <p class="section-sub" style="margin:0 auto;">
        {listings.length
          ? `${listings.length} home${listings.length === 1 ? '' : 's'} currently available through ${site.companyName}.`
          : `Check back soon — new availability is posted here as it comes on the market.`}
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:16px;">
    <div class="container">
      {listings.length ? (
        <div class="grid-3">
          {listings.map(p => {
            const imgs = photos(p);
            return (
              <a href={`/rentals/${p._id}/`} class="card" style="text-decoration:none;color:inherit;display:flex;flex-direction:column;overflow:hidden;padding:0;">
                {imgs[0]
                  ? <img src={imgs[0]} alt={street(p)} style="width:100%;height:200px;object-fit:cover;" loading="lazy" />
                  : <div style="width:100%;height:200px;background:linear-gradient(135deg,var(--color-primary) 0%,#1a3a8f 100%);display:flex;align-items:center;justify-content:center;font-size:40px;">🏠</div>
                }
                <div style="padding:20px;">
                  <div style="font-size:22px;font-weight:800;color:var(--color-ink);">
                    {money(p.marketRent?.amount)}<small style="font-size:14px;font-weight:500;color:var(--color-muted);">/mo</small>
                  </div>
                  <div style="font-size:13px;color:var(--color-muted);margin:6px 0 10px;">
                    {p.beds ?? '—'} bd &nbsp;·&nbsp; {p.baths ?? '—'} ba{p.totalArea ? ` · ${Number(p.totalArea).toLocaleString()} sq ft` : ''}
                  </div>
                  <h3 style="font-size:16px;font-weight:700;margin:0 0 4px;">{street(p)}</h3>
                  <p style="font-size:14px;color:var(--color-muted);margin:0;">{cityStateZip(p)}</p>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="card" style="text-align:center;padding:48px;">
          <p style="margin:0;color:var(--color-muted);">
            No listings are published right now. <a href={`tel:${site.phone}`} style="color:var(--color-primary);">Call us</a> to ask about upcoming availability.
          </p>
        </div>
      )}
    </div>
  </section>

  <Footer />
</BaseLayout>
